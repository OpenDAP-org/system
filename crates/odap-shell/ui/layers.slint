// The shell's system layers (shell and UI runtime spec §2, §7), drawn above every client.
// Values come from Blackbird UI's generated tokens; layout follows the interface mockups
// (blackbird-ui renders/web/ui-mockups.html, "Power, beside Main").

import { Tokens } from "@blackbird/slint/tokens.slint";
import { Blueprint, BlueprintGrid } from "@blackbird/slint/components.slint";
import "@blackbird/fonts/IBMPlexSans-Variable.ttf";
import "@blackbird/fonts/IBMPlexMono-Regular.ttf";

// A physical control where the device description places it, and whether it is down now.
export struct ControlMark {
    role: string,
    // "left", "right", "top" or "bottom"; the centre and length along it.
    edge: string,
    centre: length,
    span: length,
    down: bool,
}

// A dotted line, for references that overlap others (the side margins).
component Dotted inherits Rectangle {
    in property <color> tint;
    width: 1px;
    for i in floor(root.height / 4px): Rectangle {
        y: i * 4px;
        height: 1px;
        background: root.tint.with-alpha(0.4);
    }
}

// A region the specs define: a faint fill, lit while a contact that started in it is down.
component Zone inherits Rectangle {
    in property <color> tint;
    in property <bool> active;
    background: root.tint.with-alpha(root.active ? 0.22 : 0.05);
    animate background { duration: Tokens.motion-duration-fast; }
}

// The debug UI mode (SYS-070): the blueprint's references over the real interface, whatever it
// shows, taking no input. Regions: status bar 28 px (shell spec §2), side margins 16 px and
// edge-gesture zones 20 px (design system §8.3, §8.5), the lower half where the thumb rests
// (§8.3), the physical controls where the description places them, lit while each is down; while
// a finger is down, a crosshair with its coordinates; the gesture recognised, in a callout. The
// activities draw their own elements as blueprints (Blackbird UI's components).
component DebugUi inherits Rectangle {
    in property <float> unit: 1.0;
    in property <[ControlMark]> controls;
    in property <bool> touching;
    in property <length> touch-x;
    in property <length> touch-y;
    in property <string> touch-zone;
    in property <string> gesture;
    property <length> status-h: Tokens.size-status-bar * root.unit;
    property <length> edge-w: 20px * root.unit;
    property <length> margin-w: Tokens.space-margin * root.unit;

    BlueprintGrid { step: Tokens.size-target-min * root.unit; alpha: Blueprint.grid-major; }
    Zone { x: 0; width: root.width; y: root.height / 2; height: root.height / 2; tint: Tokens.state-success; }
    // The edge zones between the corners, and the corners where two meet: regions of their own,
    // so a contact there belongs to one region only (opendap-gesture).
    Zone { x: 0; width: root.edge-w; y: root.edge-w; height: root.height - 2 * root.edge-w; tint: Tokens.state-processing; active: root.touching && root.touch-zone == "edge-leading"; }
    Zone { x: root.width - root.edge-w; width: root.edge-w; y: root.edge-w; height: root.height - 2 * root.edge-w; tint: Tokens.state-processing; active: root.touching && root.touch-zone == "edge-trailing"; }
    Zone { x: root.edge-w; width: root.width - 2 * root.edge-w; y: root.height - root.edge-w; height: root.edge-w; tint: Tokens.state-processing; active: root.touching && root.touch-zone == "edge-bottom"; }
    Zone { x: root.edge-w; width: root.width - 2 * root.edge-w; y: 0; height: root.edge-w; tint: Tokens.state-processing; active: root.touching && root.touch-zone == "edge-top"; }
    for c in [
        { x: 0, y: 0, name: "corner-top-leading" },
        { x: 1, y: 0, name: "corner-top-trailing" },
        { x: 0, y: 1, name: "corner-bottom-leading" },
        { x: 1, y: 1, name: "corner-bottom-trailing" },
    ]: Rectangle {
        x: c.x * (root.width - root.edge-w);
        y: c.y * (root.height - root.edge-w);
        width: root.edge-w;
        height: root.edge-w;
        // A corner: the edge colour, outlined, so it reads as a region apart from both edges.
        background: Tokens.state-processing.with-alpha(root.touching && root.touch-zone == c.name ? 0.3 : 0.1);
        border-width: 1px;
        border-color: Tokens.state-processing.with-alpha(0.55);
        animate background { duration: Tokens.motion-duration-fast; }
    }
    Dotted { x: root.margin-w; height: root.height; tint: Tokens.state-warning; }
    Dotted { x: root.width - root.margin-w; height: root.height; tint: Tokens.state-warning; }
    Zone {
        x: 0;
        y: 0;
        width: root.width;
        height: root.status-h;
        tint: Tokens.state-info;
        active: false;
        Rectangle { y: parent.height - 1px; height: 1px; background: Tokens.state-info.with-alpha(0.4); }
    }

    // The physical controls: interactive areas, as the OS handles them, drawn as every other one
    // (blueprint.slint's semantics): the interactive colour at rest, live while held; the
    // geometry never changes.
    for c in root.controls: Rectangle {
        x: c.edge == "left" ? 0 : root.width - self.width;
        y: c.centre - c.span / 2;
        width: 3px;
        height: c.span;
        background: c.down ? Blueprint.live : Blueprint.interactive.with-alpha(0.7);
        animate background { duration: Tokens.motion-duration-fast; }
    }

    // While a finger is down: a crosshair through it, and where it is, kept on screen.
    if root.touching: Rectangle {
        Rectangle { x: root.touch-x; width: 1px; background: Blueprint.ink.with-alpha(Blueprint.outline); }
        Rectangle { y: root.touch-y; height: 1px; background: Blueprint.ink.with-alpha(Blueprint.outline); }
        Rectangle {
            x: min(root.touch-x + 24px, root.width - self.width - 4px);
            y: max(root.touch-y - 40px, root.status-h + 4px);
            width: coords.preferred-width + 12px;
            height: 22px;
            border-width: 1px;
            border-color: Blueprint.ink.with-alpha(Blueprint.outline);
            background: Blueprint.paper.with-alpha(0.92);
            coords := Text {
                x: 6px;
                height: parent.height;
                vertical-alignment: center;
                text: round(root.touch-x / root.unit / 1px) + ", " + round(root.touch-y / root.unit / 1px);
                font-family: Tokens.font-family-mono;
                font-size: Tokens.font-size-caption;
                color: Blueprint.ink.with-alpha(Blueprint.text);
            }
        }
    }

    // The gesture, in a callout that leaves by itself.
    if root.gesture != "": Rectangle {
        x: root.margin-w;
        width: root.width - 2 * root.margin-w;
        y: root.height - root.edge-w - Tokens.space-group - self.height;
        height: max(40px, message.preferred-height + 16px);
        background: Blueprint.paper.with-alpha(0.94);
        border-width: 1px;
        border-color: Tokens.state-info.with-alpha(0.7);
        Rectangle { x: 0; width: 3px; background: Tokens.state-info.with-alpha(0.8); }
        message := Text {
            x: 14px;
            width: parent.width - 28px;
            height: parent.height;
            vertical-alignment: center;
            wrap: word-wrap;
            text: root.gesture;
            font-family: Tokens.font-family-mono;
            font-size: Tokens.font-size-label;
            color: Blueprint.ink.with-alpha(Blueprint.text);
        }
    }
}

// The focus the volume buttons move (design system: a brighter border, `focus`).
component FocusRing inherits Rectangle {
    border-width: 2px;
    border-color: Tokens.focus;
}

component Choice inherits Rectangle {
    in property <string> label;
    in property <bool> primary;
    in property <bool> focused;
    // A pointer over it (a mouse, a simulator window): a faint surface, as the focus is a ring.
    background: touch.has-hover ? Tokens.surface-raised : transparent;
    callback activated();
    height: 56px;
    accessible-role: button;
    accessible-label: root.label;
    accessible-action-default => { root.activated(); }
    Text {
        x: 0;
        width: parent.width - Tokens.space-margin;
        height: parent.height;
        horizontal-alignment: right;
        vertical-alignment: center;
        text: root.label;
        font-family: Tokens.font-family-ui;
        font-size: Tokens.font-size-body-large;
        font-weight: root.primary ? Tokens.font-weight-semibold : Tokens.font-weight-regular;
        color: touch.pressed ? Tokens.text-muted : (root.primary ? Tokens.text-primary : Tokens.text-secondary);
    }
    if root.focused: FocusRing { }
    touch := TouchArea {
        clicked => { root.activated(); }
    }
}

// Power, beside Main: a long press of Main opens the choices next to Main itself; pressing Main
// again powers off, so the confirmation is the same physical gesture (§7: power requires it).
// Touching "Power off" only points at that press. Restart and recovery are touch choices.
// The buttons alone work it too (SYS-039): Volume + and − move the focus, Action takes the
// focused choice, Main powers off.
component PowerMenu inherits Rectangle {
    in property <length> main-y;
    in property <bool> can-recovery;
    in-out property <bool> point-at-main;
    // The focused choice: 0 Power off, 1 Restart, 2 Restart to recovery (when present), then
    // Cancel; -1 for none.
    in property <int> focused-choice;
    callback choose(string);

    // A system view precedes the shell (SYS-069): it takes the whole screen, with no status bar
    // or any other shell layer showing; a touch on its ground does nothing.
    Rectangle {
        background: Tokens.color-graphite-950.darker(30%);
        TouchArea { }
    }
    // The choices run the full width, their labels at the right, beside Main.
    choices := VerticalLayout {
        x: 0;
        width: parent.width;
        y: max(0, min(root.main-y - 28px, parent.height - self.preferred-height - 76px));
        Choice {
            label: "Power off";
            primary: true;
            focused: root.focused-choice == 0;
            activated => { root.point-at-main = true; }
        }
        Choice {
            label: "Restart";
            focused: root.focused-choice == 1;
            activated => { root.choose("restart"); }
        }
        if root.can-recovery: Choice {
            label: "Restart to recovery";
            focused: root.focused-choice == 2;
            activated => { root.choose("recovery"); }
        }
        // The mockup's padding: a group space above, the margin on the right.
        HorizontalLayout {
            padding-top: Tokens.space-group;
            padding-right: Tokens.space-margin;
            Text {
                text: "Press Main again to power off";
                horizontal-alignment: right;
                font-family: Tokens.font-family-ui;
                font-size: Tokens.font-size-label;
                color: root.point-at-main ? Tokens.text-primary : Tokens.text-muted;
                accessible-role: text;
            }
        }
    }
    // Cancel, at the bottom, apart from the destructive choices.
    Rectangle {
        x: Tokens.space-margin;
        width: parent.width - 2 * Tokens.space-margin;
        y: parent.height - 12px - self.height;
        height: 52px;
        border-radius: Tokens.radius-pill;
        background: cancel.has-hover ? Tokens.surface-raised : transparent;
        accessible-role: button;
        accessible-label: "Cancel";
        accessible-action-default => { root.choose("cancel"); }
        Text {
            text: "Cancel";
            font-family: Tokens.font-family-ui;
            font-size: Tokens.font-size-body-large;
            font-weight: Tokens.font-weight-medium;
            color: cancel.pressed ? Tokens.text-muted : Tokens.text-secondary;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
        if root.focused-choice == (root.can-recovery ? 3 : 2): FocusRing { border-radius: parent.border-radius; }
        cancel := TouchArea {
            clicked => { root.choose("cancel"); }
        }
    }
}

// A short bar that leaves by itself, with no input (user-facing conventions: Material's snackbar).
component Toast inherits Rectangle {
    in property <string> text;
    height: 48px;
    border-radius: Tokens.radius-control;
    background: Tokens.surface-raised;
    accessible-role: AccessibleRole.text;
    accessible-label: root.text;
    Text {
        x: Tokens.space-margin;
        width: parent.width - 2 * Tokens.space-margin;
        height: parent.height;
        vertical-alignment: center;
        text: root.text;
        font-family: Tokens.font-family-ui;
        font-size: Tokens.font-size-body;
        color: Tokens.text-primary;
    }
}

export component Layers inherits Window {
    in property <string> toast;
    in property <bool> power-open;
    in property <length> main-y;
    in property <bool> can-recovery;
    in-out property <bool> point-at-main;
    in property <int> focused-choice: -1;
    callback power-choice(string);
    // The debug UI mode (layers.rs sets it from the flag).
    in property <bool> debug;
    in property <float> unit: 1.0;
    in property <[ControlMark]> controls;
    in property <bool> touching;
    in property <length> touch-x;
    in property <length> touch-y;
    in property <string> touch-zone;
    in property <string> gesture;
    background: transparent;

    if root.power-open: PowerMenu {
        width: parent.width;
        height: parent.height;
        main-y: root.main-y;
        can-recovery: root.can-recovery;
        point-at-main <=> root.point-at-main;
        focused-choice: root.focused-choice;
        choose(what) => { root.power-choice(what); }
    }
    if root.toast != "": Toast {
        x: Tokens.space-margin;
        width: parent.width - 2 * Tokens.space-margin;
        y: parent.height - 12px - self.height;
        text: root.toast;
    }
    // Above everything, system views included, and taking no input.
    if root.debug: DebugUi {
        width: parent.width;
        height: parent.height;
        unit: root.unit;
        controls: root.controls;
        touching: root.touching;
        touch-x: root.touch-x;
        touch-y: root.touch-y;
        touch-zone: root.touch-zone;
        gesture: root.gesture;
    }
}
